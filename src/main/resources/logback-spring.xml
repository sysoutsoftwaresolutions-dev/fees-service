<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Import default Spring Boot logback configuration base -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Define log paths and patterns -->
    <property name="LOG_FILE_PATH" value="logs"/>
    <property name="LOG_FILE_NAME" value="fees-service"/>
    
    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}</pattern>
        </encoder>
    </appender>

    <!-- Rolling File Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE_PATH}/${LOG_FILE_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE_PATH}/archived/${LOG_FILE_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!-- Max file size per log segment -->
            <maxFileSize>10MB</maxFileSize>
            <!-- Retain up to 30 days of logs -->
            <maxHistory>30</maxHistory>
            <!-- Limit total size of archived logs -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p ${PID:- } --- [%t] %-40.40logger{39} : %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}</pattern>
        </encoder>
    </appender>

    <!-- Logger configurations -->
    <logger name="org.springframework" level="INFO" />

    <!-- Environment-specific log levels -->
    <springProfile name="dev | local | default">
        <logger name="com.school" level="DEBUG" />
        <logger name="com.core" level="DEBUG" />
    </springProfile>

    <springProfile name="prod | staging">
        <logger name="com.school" level="INFO" />
        <logger name="com.core" level="INFO" />
    </springProfile>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>
